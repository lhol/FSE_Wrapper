<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Fse.Net</PackageId>
    <Version>0.2.0</Version>
    <Authors>Lars Holzinger</Authors>
    <Description>Cross-platform FSE (Finite State Entropy) compression/decompression bindings for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lhol/FSE_Wrapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lhol/FSE_Wrapper</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\runtimes\**\*" Pack="true" PackagePath="runtimes/" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
